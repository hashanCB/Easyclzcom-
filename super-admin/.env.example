# =============================================================================
# Teacher Class Management — environment template
# =============================================================================
# Copy to `.env` (or `.env.local` per app) and fill in real values.
# `.env.example` is committed; `.env*` (without `.example`) are gitignored.
#
# Get the local-dev values by running:
#   pnpm --filter @shared/db-schema supabase:start
# Cloud values come from your Supabase dashboard:
#   https://supabase.com/dashboard/project/<project-ref>/settings/api
# =============================================================================


# -----------------------------------------------------------------------------
# Supabase — cloud project
# -----------------------------------------------------------------------------
# Project ref shown in dashboard URL (e.g. abcdefghijklmnop).
SUPABASE_PROJECT_REF=

# Public API URL — safe to expose to clients.
SUPABASE_URL=https://<project-ref>.supabase.co

# Anon key — safe to expose to clients (RLS enforces row access).
SUPABASE_ANON_KEY=

# Service-role key — server-side only. NEVER ship to mobile/web clients.
# Used by Next.js server actions, edge functions, and admin scripts.
SUPABASE_SERVICE_ROLE_KEY=

# JWT secret — only needed for verifying tokens in custom backends.
SUPABASE_JWT_SECRET=


# -----------------------------------------------------------------------------
# Supabase — local stack (printed by `supabase start`)
# -----------------------------------------------------------------------------
SUPABASE_LOCAL_URL=http://127.0.0.1:54321
SUPABASE_LOCAL_ANON_KEY=
SUPABASE_LOCAL_SERVICE_ROLE_KEY=
SUPABASE_LOCAL_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres


# -----------------------------------------------------------------------------
# Next.js super-admin dashboard (apps/admin-web) — set in apps/admin-web/.env.local
# -----------------------------------------------------------------------------
# Public — exposed to browser bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Private — server-only.
SUPABASE_SERVICE_ROLE_KEY_ADMIN_WEB=


# -----------------------------------------------------------------------------
# Expo mobile apps (apps/teacher-mobile, apps/student-mobile)
# -----------------------------------------------------------------------------
# Expo only ships variables prefixed with EXPO_PUBLIC_ to the client.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=


# -----------------------------------------------------------------------------
# Cloudflare R2 (file storage) — wired up in U25
# -----------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=


# -----------------------------------------------------------------------------
# Stripe (subscriptions) — wired up in U26
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=


# -----------------------------------------------------------------------------
# SMS providers (Notify.lk default + Twilio adapter per ADR-003) — wired in U34
# -----------------------------------------------------------------------------
NOTIFY_LK_USER_ID=
NOTIFY_LK_API_KEY=
NOTIFY_LK_SENDER_ID=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=


# -----------------------------------------------------------------------------
# QR signed-token HMAC secret (ADR-008) — generate with shared-utils
# -----------------------------------------------------------------------------
# Run once: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
QR_HMAC_SECRET=
