# Copy to `.env.local` (gitignored). Local-dev defaults match the values printed by
#   pnpm --filter @shared/db-schema supabase:start

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only — service-role key (NEVER expose to the browser).
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (optional — webhook won't work without these)
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Get from https://dashboard.stripe.com/webhooks (or `stripe listen` for local dev)
STRIPE_WEBHOOK_SECRET=
