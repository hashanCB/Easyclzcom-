# Teacher app (Expo) — environment variables template.
# Copy to .env (or .env.local) and fill in values.
# All EXPO_PUBLIC_* vars are embedded in the client bundle (public).

# Supabase project URL — from the Supabase dashboard, or `supabase status` for local
EXPO_PUBLIC_SUPABASE_URL=

# Supabase anon/publishable key (public)
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare R2 file worker URL (optional; falls back to the prod worker if unset)
EXPO_PUBLIC_R2_WORKER_URL=
