# Student web app (Next.js) — environment variables
# Copy this file to .env.local and fill in real values for local dev.
# In Vercel, add these under Settings -> Environment Variables.

# Supabase project URL (public)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/publishable key (public; safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
